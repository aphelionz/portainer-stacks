      "ollama": {
        "baseUrl": "http://ollama:11434/v1",
        "apiKey": "ollama-local",
        "api": "openai-completions",
        "models": [
          {
            "id": "mistral:7b-instruct",
            "name": "Mistral 2.5 7B Instruct",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/mistral:7b-instruct"
      },
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "sandbox": {
        "mode": "all",
        "workspaceAccess": "ro",
        "scope": "agent"
      }
    },
    "list": [
      {
        "id": "gallery_ed",
        "default": true,
        "workspace": "/home/node/.openclaw/workspace",
        "groupChat": {
          "mentionPatterns": [
            "@openclaw",
            "openclaw"
          ]
        }
      },
      {
        "id": "admin",
        "workspace": "/home/node/.openclaw/workspace",
        "groupChat": {
          "mentionPatterns": [
            "@openclaw",
            "openclaw"
          ]
        }
      }
    ]
  },
  "tools": {
