    "allow": [
      "group:web"
    ],
    "deny": [
      "group:fs",
      "group:runtime",
      "group:ui",
      "group:automation",
      "group:messaging",
      "group:nodes",
      "group:memory"
    ],
    "web": {
      "search": {
        "enabled": true,
        "apiKey": "REDACTED"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "messages": {
