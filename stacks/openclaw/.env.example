# Images
OPENCLAW_IMAGE=openclaw:local
OLLAMA_IMAGE=ollama/ollama:0.15.2

# Bind mounts (set by Ansible)
OPENCLAW_CONFIG_DIR=/srv/openclaw/config
OPENCLAW_WORKSPACE_DIR=/srv/openclaw/workspace
OLLAMA_DATA_DIR=/srv/openclaw/ollama
OPENCLAW_DOCKER_GID=999

# Gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_HOST_IP=127.0.0.1
OPENCLAW_GATEWAY_TOKEN=

# WireGuard HTTPS access (Caddy)
OPENCLAW_GATEWAY_HOSTNAME=hyphae
OPENCLAW_WG_HOST_IP=10.10.0.1
OPENCLAW_HTTPS_PORT=18443

# Models
OPENCLAW_PRIMARY_MODEL=ollama/llama3.3

# Optional web search
BRAVE_API_KEY=
